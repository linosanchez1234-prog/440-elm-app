rules_version = '2';

// 440 Elm online library and status page.
// Replace the two emails below with the same ones you put in cloud-config.js, in lowercase.
// Only these two sign-ins can read anything. Only the owner can change events.
// Staff can tick lines and add notes on published events, and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'owner@example.com';
    }
    function isStaff() {
      return request.auth != null && request.auth.token.email == 'staff@example.com';
    }
    function isPublished(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.published == true;
    }

    // Event summary, published checklist and shifts.
    match /events/{eventId} {
      allow read, write: if isOwner();
      allow read: if isStaff() && resource.data.published == true;

      // Full intake answers. Owner only.
      match /draft/{part} {
        allow read, write: if isOwner();
      }

      // Done marks and notes. Staff can read and mark them on published events, but cannot delete the record.
      match /status/{doc} {
        allow read, write: if isOwner();
        allow read: if isStaff() && isPublished(eventId);
        allow create, update: if isStaff() && isPublished(eventId) && doc == 'items'
                              && request.resource.data.keys().hasOnly(['items']);
      }
    }
  }
}
